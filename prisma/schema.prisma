generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model Actividad {
  id         String   @id @default(cuid())
  dia        String
  hora       String
  lugar      String
  director   String
  predicador String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
